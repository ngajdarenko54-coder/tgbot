# Токен от @BotFather. Никому не показывай и не коммить настоящий .env
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# Ссылка на канал (необязательно)
CHANNEL_URL=
# Имя параметра субайди в партнёрских ссылках Pampadu (уточнить у менеджера)
SUBID_PARAM=sub1
# Через сколько часов спросить «как дела с откликом»
FOLLOWUP_HOURS=48
DB_PATH=data/bot.db
JOBS_XLSX=data/jobs.xlsx
